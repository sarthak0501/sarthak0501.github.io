---
layout: layouts/base.njk
desc: "Sarthak Bichhawa — data scientist at Microsoft Azure Storage. Explore my work in product measurement, trusted data, and applied AI, or ask my portfolio assistant."
---

<div class="home-opening">
  <header class="home-hero wrap">
    <div class="hero-copy">
      <div class="hero-identity">
        <img src="/assets/sarthak.jpg" alt="Sarthak Bichhawa" width="64" height="64" fetchpriority="high" decoding="async" />
        <p><strong>{{ facts.identity.title }} · {{ facts.identity.org }}</strong><span>{{ facts.identity.team }} · {{ facts.identity.location }}</span></p>
      </div>
      <h1 class="hero-title">Hi, I’m <span>Sarthak<span class="sr-only"> Bichhawa</span>.</span></h1>
      <p class="hero-intro">I work on product measurement, data platforms, and applied AI at Microsoft Azure Storage. I help teams understand customer health, investigate incidents, and trust their data.</p>
      <div class="hero-assistant-invite" hidden>
        <button type="button" class="assistant-launcher" id="assistant-launcher" aria-haspopup="dialog" aria-controls="assistant-dialog" aria-expanded="false">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 18 3 21V6a3 3 0 0 1 3-3h12a3 3 0 0 1 3 3v9a3 3 0 0 1-3 3H7Z"/><path d="M8 8h8M8 12h5"/></svg>
          <span>Ask my AI assistant</span><span class="assistant-launcher-arrow" aria-hidden="true">↗</span>
        </button>
        <p>Ask about my work, or compare a role.</p>
      </div>
      <div class="hero-links"><a href="{{ facts.resume.file }}" data-goatcounter-click="hero-resume-pdf">View résumé <span aria-hidden="true">↗</span></a><a href="mailto:{{ facts.identity.email }}" data-goatcounter-click="hero-email">Get in touch <span aria-hidden="true">↗</span></a><a href="{{ facts.identity.linkedin }}">LinkedIn <span aria-hidden="true">↗</span></a></div>
      <ul class="hero-evidence" aria-label="Selected outcomes">
        <li><a href="{{ facts.receipts[0].anchor }}"><strong>{{ facts.receipts[0].value }}</strong><span>Partner attribution recovered</span></a></li>
        <li><a href="{{ facts.receipts[2].anchor }}"><strong>{{ facts.receipts[2].value }}</strong><span>On-call incident diagnosis</span></a></li>
        <li><a href="{{ facts.receipts[3].anchor }}"><strong>{{ facts.receipts[3].value | replace('2 min', '2 min') }}</strong><span>Executive-review preparation</span></a></li>
      </ul>
    </div>
  </header>

  <section class="home-assistant wrap" id="assistant" aria-labelledby="assistant-heading" data-portfolio-assistant data-site-url="{{ facts.meta.site_url }}" data-availability="checking" data-privacy-revision="2026-10-10-logging-v1">
    <div class="assistant-stage">
      <div class="assistant-stage-head">
        <div class="assistant-heading-copy">
          <span class="assistant-ai-label"><svg class="assistant-symbol" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 18 3 21V6a3 3 0 0 1 3-3h12a3 3 0 0 1 3 3v9a3 3 0 0 1-3 3H7Z"/><path d="M8 8h8M8 12h5"/></svg> AI portfolio assistant</span>
          <h2 id="assistant-heading">Ask about my work.</h2>
          <p>Explore a project, dig into a technical decision, or compare a role.</p>
        </div>
        <button class="assistant-clear" type="button" id="assistant-clear" disabled>Clear</button>
      </div>
      <div class="assistant-conversation" id="assistant-conversation" role="region" aria-label="Conversation with the AI portfolio assistant" tabindex="0" hidden></div>
      <div class="assistant-thinking" id="assistant-thinking" aria-hidden="true" hidden>
        <span class="assistant-thinking-dots"><span class="assistant-thinking-dot"></span><span class="assistant-thinking-dot"></span><span class="assistant-thinking-dot"></span></span>
        <span id="assistant-thinking-label">Thinking…</span>
      </div>
      <div id="assistant-live" class="assistant-live">
        <form class="assistant-form" id="assistant-form">
          <div class="assistant-composer">
            <div class="assistant-modes" role="group" aria-label="Assistant mode">
              <button type="button" data-assistant-mode="question" aria-pressed="true">Ask a question</button>
              <button type="button" data-assistant-mode="match" aria-pressed="false">Compare a role</button>
            </div>
            <div id="assistant-question-field" class="assistant-field">
              <label class="sr-only" for="assistant-question">Your question about Sarthak</label>
              <textarea id="assistant-question" name="question" rows="2" maxlength="1200" required placeholder="Ask about my projects, technical decisions, or experience…" aria-describedby="assistant-status assistant-input-note assistant-privacy assistant-counter"></textarea>
            </div>
            <div id="assistant-match-field" class="assistant-field" hidden>
              <label class="sr-only" for="assistant-job">Public job description</label>
              <textarea id="assistant-job" name="jobDescription" rows="4" maxlength="6000" disabled placeholder="Paste a public job description. See relevant experience and honest gaps." aria-describedby="assistant-status assistant-input-note assistant-privacy assistant-counter"></textarea>
            </div>
            <div class="assistant-composer-bottom">
              <p class="assistant-input-note" id="assistant-input-note">Public questions only. Sent to OpenAI; saved for Sarthak’s private review.</p>
              <span class="assistant-counter" id="assistant-counter">0 / 1,200</span>
              <button class="assistant-cancel" id="assistant-cancel" type="button" hidden>Stop</button>
              <button class="assistant-send" id="assistant-send" type="submit" disabled aria-describedby="assistant-status"><span class="sr-only" id="assistant-send-label">Ask the assistant</span><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5m-6 6 6-6 6 6"/></svg></button>
            </div>
          </div>
          <p id="assistant-status" class="assistant-status" role="status" aria-live="polite" aria-atomic="true">Checking live AI availability…</p>
          <p class="sr-only" id="assistant-privacy">Use public information only. Your text and up to two previous questions are sent to OpenAI when you send. Submitted questions or job descriptions and replies are saved for Sarthak’s private review and local archive. Do not include personal or confidential information.</p>
        </form>
      </div>
      <div id="assistant-welcome" class="assistant-welcome">
        <div class="assistant-suggestions" id="assistant-suggestions" role="group" aria-label="Explore curated public answers">
          <span>Or start here</span>
          <button type="button" data-guide="why" aria-pressed="false" aria-controls="guide-why">Business impact <span aria-hidden="true">↗</span></button>
          <button type="button" data-guide="ai" aria-pressed="false" aria-controls="guide-ai">Technical approach <span aria-hidden="true">↗</span></button>
          <button type="button" data-guide="leadership" aria-pressed="false" aria-controls="guide-leadership">Leadership <span aria-hidden="true">↗</span></button>
        </div>
        <div class="guide-answer" id="guide-answer" hidden>
          <div class="guide-answer-head"><span>Curated public answer</span><button type="button" id="guide-close" aria-label="Close curated answer">×</button></div>
          <article id="guide-why" data-guide-panel="why" aria-labelledby="guide-why-title" hidden>
            <h3 id="guide-why-title">Making the numbers useful—and trustworthy.</h3>
            <p>Sarthak’s work connects measurement to decisions. At Azure Storage, he recovered ~$45M/mo in partner revenue attribution on a $5B+/yr platform, established independent Finance reconciliation, and designed customer-health metrics across 8+ teams.</p>
            <div class="guide-sources"><a href="/resume/#record-microsoft">Customer-health measurement <span aria-hidden="true">↗</span></a><a href="/case/revenue-attribution/#recovery">Revenue recovery <span aria-hidden="true">↗</span></a></div>
          </article>
          <article id="guide-ai" data-guide-panel="ai" aria-labelledby="guide-ai-title" hidden>
            <h3 id="guide-ai-title">How does he check the answer?</h3>
            <p>The incident agent tests hypotheses against live telemetry, with confidence scoring and run tracing. The customer-health agent uses governed queries across 13 metric domains. Four reusable MCP servers provide telemetry access. The case studies explain the architecture, validation, and limits.</p>
            <div class="guide-sources"><a href="/case/incident-agent/#architecture">Incident AI & MCP <span aria-hidden="true">↗</span></a><a href="/case/customer-health-agent/">Customer-health AI <span aria-hidden="true">↗</span></a></div>
          </article>
          <article id="guide-leadership" data-guide-panel="leadership" aria-labelledby="guide-leadership-title" hidden>
            <h3 id="guide-leadership-title">What has he led beyond the model?</h3>
            <p>At Microsoft, Sarthak aligned 8+ teams around customer-health measurement, led a 4-team incident response, and delivered hands-on AI workshops for 250+ engineers, data scientists, and PMs per session. At Walmart, he led 4 data scientists/analysts and 2 interns to productionize an item-level placement workflow.</p>
            <div class="guide-sources"><a href="/resume/#record-microsoft">Microsoft experience <span aria-hidden="true">↗</span></a><a href="/resume/#record-walmart">Walmart experience <span aria-hidden="true">↗</span></a></div>
          </article>
        </div>
      </div>
      <details class="assistant-about">
        <summary>Answers grounded in my public work <span>How it works</span></summary>
        <div><p>The guided answers are curated website content. Live replies come from an AI portfolio assistant that makes the strongest case supported by Sarthak’s public work, with evidence links and honest gaps. It is not Sarthak speaking or a firsthand reference.</p><p>Use only public questions or public job descriptions. Sending transmits your text and up to two earlier questions to OpenAI. Submitted questions, job descriptions, and replies are saved for Sarthak’s private review: at least 31 days in the cloud, then eligible for removal only after a verified local backup. Local archives are retained until deleted by Sarthak. Nothing is sent when you type or explore a guided answer. “Clear” or reload clears this tab’s display, not saved records. Source revision: {{ facts.meta.resume_rev }}. Replies may contain errors; check the sources. <a href="/colophon/#assistant-privacy">Privacy and processing details</a>.</p></div>
      </details>
      <noscript><p class="assistant-no-script">Live AI needs JavaScript. Explore the <a href="/case/">case studies</a> or <a href="/resume/">résumé</a>.</p></noscript>
    </div>
  </section>
  <a class="explore-work" href="#work">Explore the work <span aria-hidden="true">↓</span></a>
</div>

{% include "partials/home-work.njk" %}

<section class="home-experience wrap" id="experience" aria-labelledby="experience-heading">
  <div class="experience-intro">
    <p class="section-label">A little about me</p>
    <h2 id="experience-heading">From the first question<br />to the system people use.</h2>
    <p>My work spans product measurement, production ML, and applied AI. At Walmart, I worked on shelf-layout optimization. At Microsoft, I work on the data and systems behind customer health, reliability, and revenue decisions.</p>
    <p>I also enjoy teaching: my hands-on AI workshops bring together 250+ engineers, data scientists, and product managers per session.</p>
    <a class="text-link" href="/resume/">My full experience <span aria-hidden="true">↗</span></a>
  </div>
  <ol class="career-list" aria-label="Career history">
    {% for role in facts.record %}
    <li><a href="/resume/#{{ role.id }}"><span class="career-company">{{ role.company }}</span><span class="career-date">{{ role.dates }}</span><span class="career-arrow" aria-hidden="true">↗</span></a></li>
    {% endfor %}
  </ol>
</section>

<dialog class="assistant-dialog" id="assistant-dialog" aria-labelledby="assistant-heading">
  <div class="assistant-dialog-toolbar"><span>A conversation about my work</span><button type="button" id="assistant-close" aria-label="Close AI assistant">Close <span aria-hidden="true">×</span></button></div>
</dialog>

<section class="home-writing wrap" id="writing" aria-labelledby="writing-heading">
  <div class="home-section-head"><h2 id="writing-heading">Notes from the work.</h2><a class="text-link" href="/writing/">All writing <span aria-hidden="true">↗</span></a></div>
  <ul class="home-notes">
    {% for w in facts.writing %}{% if w.url %}
    <li><a href="{{ w.url }}"><span class="note-date">{{ w.date | humanDate }}</span><h3>{{ w.title }}</h3><span class="note-read">Read the essay <span aria-hidden="true">↗</span></span></a></li>
    {% endif %}{% endfor %}
  </ul>
</section>

<section class="home-contact" id="contact" aria-labelledby="contact-heading">
  <div class="wrap">
    <p class="section-label">Get in touch</p>
    <h2 id="contact-heading">Let’s compare notes.</h2>
    <p>Have a data problem, a role in mind, or a question about my work? I’d be glad to hear from you.</p>
    <a class="contact-primary" href="mailto:{{ facts.identity.email }}" data-goatcounter-click="contact-email">Get in touch <span aria-hidden="true">↗</span></a>
    <div class="contact-links"><a href="{{ facts.resume.file }}">Download résumé</a><a href="{{ facts.identity.linkedin }}">LinkedIn</a><a href="{{ facts.identity.github }}">GitHub</a></div>
    <details class="contact-summary"><summary>Copy a short introduction</summary><div><pre id="ats-summary">{{ facts.summary.ats }}
Site: {{ facts.meta.site_url }} · Résumé: {{ facts.meta.site_url }}{{ facts.resume.file }} · LinkedIn: {{ facts.identity.linkedin }} · Email: {{ facts.identity.email }}</pre><button class="btn btn-secondary btn-sm copy-btn" type="button">Copy</button></div></details>
  </div>
</section>
