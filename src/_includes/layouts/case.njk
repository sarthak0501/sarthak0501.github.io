---
layout: layouts/base.njk
---
<article class="section-pad page-head case-page">
  <div class="wrap">
    <nav class="crumb" aria-label="Breadcrumb">‹ <a href="/case/">All case files</a></nav>

    <header class="reveal">
      {% if tag %}<div class="exhibit-tag">{{ tag }}</div>{% endif %}
      <h1 class="case-title flip">{{ title }}</h1>
      {% if lede %}<p class="case-lede">{{ lede | safe }}</p>{% endif %}
    </header>

    <div class="case-meta panel reveal">
      <div><span class="k">Role</span><span class="v">{{ role }}</span></div>
      <div><span class="k">Stack</span><span class="v">{{ stack }}</span></div>
      <div><span class="k">Status</span><span class="v g">{{ status }}</span></div>
      <div><span class="k">Headline</span><span class="v g">{{ headline }}</span></div>
    </div>

    {{ content | safe }}

    {% if next %}
    <p style="margin-top:3rem;">
      <a class="case-cta panel" href="{{ next.url }}">
        <span>Next case file — {{ next.title }}</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </p>
    {% endif %}
  </div>
</article>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": {{ title | dump | safe }},
  "description": {{ desc | dump | safe }},
  "url": "{{ facts.meta.site_url }}{{ page.url }}",
  "author": { "@type": "Person", "name": "{{ facts.identity.name }}", "url": "{{ facts.meta.site_url }}/" },
  "dateModified": "{{ build.updatedISO }}"
}
</script>
