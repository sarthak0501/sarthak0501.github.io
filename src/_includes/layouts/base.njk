<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#0a0e0c" />

  <title>{{ title if title else facts.identity.name + " — " + facts.identity.title + " · " + facts.identity.org }}</title>
  <meta name="description" content="{{ desc if desc else facts.summary.hero }}" />
  <meta name="author" content="{{ facts.identity.name }}" />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="canonical" href="{{ facts.meta.site_url }}{{ page.url }}" />
  {% if noindex %}<meta name="robots" content="noindex" />{% endif %}

  <!-- Open Graph -->
  <meta property="og:type" content="{{ 'article' if layout == 'layouts/post.njk' else 'website' }}" />
  <meta property="og:url" content="{{ facts.meta.site_url }}{{ page.url }}" />
  <meta property="og:title" content="{{ title if title else 'The case for hiring ' + facts.identity.name }}" />
  <meta property="og:description" content="{{ desc if desc else facts.summary.hero }}" />
  <meta property="og:image" content="{{ facts.meta.site_url }}{{ ogImage if ogImage else '/og-image.png' }}" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="{{ ogImageAlt if ogImageAlt else 'The case for hiring Sarthak Bichhawa — a hiring brief with receipts attached' }}" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ title if title else 'The case for hiring ' + facts.identity.name }}" />
  <meta name="twitter:description" content="{{ desc if desc else facts.summary.hero }}" />
  <meta name="twitter:image" content="{{ facts.meta.site_url }}{{ ogImage if ogImage else '/og-image.png' }}" />

  <!-- self-hosted fonts -->
  <link rel="preload" href="/fonts/fraunces-var.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/inter-var.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="/css/tokens.css" />
  <link rel="stylesheet" href="/css/site.css" />

  {% if page.url == "/" %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Sarthak Bichhawa",
    "url": "https://sarthak0501.github.io/",
    "jobTitle": "Senior Data & Applied Scientist",
    "worksFor": { "@type": "Organization", "name": "Microsoft" },
    "email": "mailto:sarthaksgsits@gmail.com",
    "address": { "@type": "PostalAddress", "addressLocality": "Redmond", "addressRegion": "WA", "addressCountry": "US" },
    "knowsAbout": ["LLM agents", "Azure OpenAI", "Machine learning", "Embeddings", "Representation learning", "MLOps", "Data platforms", "Model Context Protocol"],
    "sameAs": [
      "https://www.linkedin.com/in/sarthak-bichhawa/",
      "https://github.com/sarthak0501"
    ],
    "alumniOf": [
      { "@type": "CollegeOrUniversity", "name": "University of Illinois at Chicago" },
      { "@type": "CollegeOrUniversity", "name": "SGSITS, Indore" }
    ]
  }
  </script>
  {% endif %}

  <script src="/js/main.js" defer></script>
  <noscript><style>.reveal { opacity: 1; transform: none; } .lane[hidden] { display: block; } .lanes-tabs { display: none; }</style></noscript>
</head>
<body>

<a href="#main" class="skip-link">Skip to content</a>

{% if tape %}{% include "partials/tape.njk" %}{% endif %}

{% include "partials/nav.njk" %}

<main id="main">
{{ content | safe }}
</main>

{% include "partials/footer.njk" %}

<script data-goatcounter="https://{{ facts.meta.goatcounter }}.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>
</body>
</html>
