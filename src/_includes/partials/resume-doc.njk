{#
  The public experience record, rendered from facts.yaml and reconciled
  with the one authored PDF. Includes previously supported project detail.
#}
{% set ms = facts.record[0] %}
<div class="resume-doc">
  <header>
    <div class="r-name">{{ facts.identity.name }}</div>
    <p class="r-title">{{ facts.identity.title }} · {{ facts.identity.org }}, {{ facts.identity.team }}</p>
    <p class="r-contact">
      {{ facts.identity.location }} · <a href="mailto:{{ facts.identity.email }}">{{ facts.identity.email }}</a> ·
      <a href="{{ facts.identity.linkedin }}">{{ facts.identity.linkedin_label }}</a> ·
      <a href="{{ facts.identity.github }}">github.com/sarthak0501</a> ·
      <a href="{{ facts.meta.site_url }}/">{{ facts.meta.site_url | replace("https://", "") }}</a>
    </p>
    <p class="r-summary">{{ facts.summary.ats }}</p>
  </header>

  <section class="r-sec">
    <h2>Experience</h2>

    <div class="r-item" id="{{ ms.id }}">
      <div class="r-row">
        <h3>{{ ms.role }}</h3>
        <span class="r-co">{{ ms.company }} · {{ ms.location }}</span>
        <span class="r-dates">{{ ms.dates }}</span>
      </div>
      {% if ms.scope %}<p class="r-scope">{{ ms.scope }}</p>{% endif %}
      {%- for ws in ms.workstreams %}
      <div class="r-ws">{{ ws.name }}</div>
      <ul>
        {%- for b in ws.bullets %}<li>{{ b }}</li>{% endfor %}
      </ul>
      {%- endfor %}
      <div class="r-ws">Leadership</div>
      <ul>
        {%- for item in ms.leadership_band %}<li>{{ item }}</li>{% endfor %}
      </ul>
    </div>

    {%- for r in facts.record %}{% if not loop.first %}
    <div class="r-item" id="{{ r.id }}">
      <div class="r-row">
        <h3>{{ r.role }}</h3>
        <span class="r-co">{{ r.company }} · {{ r.location }}</span>
        <span class="r-dates">{{ r.dates }}</span>
      </div>
      <ul>
        {%- for b in r.bullets %}<li>{{ b }}</li>{% endfor %}
      </ul>
    </div>
    {%- endif %}{% endfor %}
  </section>

  <section class="r-sec">
    <h2>Skills</h2>
    <div class="r-skills">
      <div><b>Analytics & measurement</b> {{ facts.skills.analytics }}</div>
      <div><b>AI / ML</b> {{ facts.skills.ai_ml }}</div>
      <div><b>Tools</b> {{ facts.skills.tools }}</div>
      <div><b>Platforms</b> {{ facts.skills.platforms }}</div>
    </div>
  </section>

  <section class="r-sec">
    <h2>Education</h2>
    <div class="r-skills">
      {%- for e in facts.education %}
      <div><b>{{ e.school }}</b> {{ e.degree }} · {{ e.dates }}</div>
      {%- endfor %}
    </div>
  </section>
</div>
